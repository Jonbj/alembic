# Backtest venv (host-side, not needed with Docker)
.venv-backtest/
# Firebase Android client configuration is deployment-specific and private.
/mobile/android/app/google-services.json
/mobile/android/app/src/debug/google-services.json
/mobile/android/app/src/release/google-services.json

# Android SDK / Gradle cache / JDK scaricati in locale (~5 GB). Ricostruibili,
# specifici della macchina, mai da versionare.
/.android-toolchain/

# Skill Claude Code installate da sorgenti esterne: sono una dipendenza,
# ricostruibile da skills-lock.json (che invece e' versionato).
/.claude/skills/
/.agents/

# Lock di sessione riscritto a ogni avvio: churn puro, non stato del progetto.
.claude/scheduled_tasks.lock

# Backup di dati DB prodotti dagli script one-shot: dati di ambiente, non di repo
backups/

# Stato runtime della notifica one-shot del kill criterion S4 (#180): e'
# informazione di quando l'ultimo PASS/FAIL e' stato annunciato, non un
# artefatto decisionale (quello vive in docs/evidence/s4_ic.json).
docs/evidence/s4_ic_notification.json
