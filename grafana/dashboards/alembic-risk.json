  "title": "Alembic - Risk Monitor",
  "description": "Multi-strategy risk exposure, weights, confidence, and alerts",
  "tags": [
    "alembic",
    "risk"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Overview",
