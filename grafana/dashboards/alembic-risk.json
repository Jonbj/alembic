        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "alembic-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  timestamp                            AS \"Time\",\n  jsonb_array_length(alerts)           AS \"Alert Count\",\n  ROUND(total_exposure::numeric, 4)    AS \"Total Exposure\",\n  ROUND(herfindahl_index::numeric, 4)  AS \"HHI\",\n  ROUND(combined_drawdown::numeric, 4) AS \"Combined Drawdown\",\n  ROUND(nav::numeric, 2)               AS \"NAV\"\nFROM risk_reports\nWHERE $__timeFilter(timestamp)\nORDER BY timestamp DESC\nLIMIT 20",
          "refId": "A",
          "sql": {}
        }
      ]
    }
