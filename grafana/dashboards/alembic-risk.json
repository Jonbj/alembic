      "url": "/d/alembic-overview",
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Portfolio Risk Exposure",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "alembic-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true,
            "axisCenteredZero": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Herfindahl Index"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Combined Drawdown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "alembic-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  timestamp AS time,\n  total_exposure   AS \"Total Exposure\",\n  herfindahl_index AS \"Herfindahl Index\",\n  ABS(combined_drawdown) AS \"Combined Drawdown\"\nFROM risk_reports\nWHERE $__timeFilter(timestamp)\nORDER BY timestamp",
          "refId": "A",
          "sql": {}
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LLM Model Weights Over Time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "alembic-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "alembic-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  applied_at AS time,\n  COALESCE((applied_weights->>'qwen3.5:397b')::numeric, 0) AS \"Qwen3.5\",\n  COALESCE((applied_weights->>'glm-5.1:cloud')::numeric, 0) AS \"GLM-5.1\",\n  COALESCE((applied_weights->>'kimi-k2.6:cloud')::numeric, 0) AS \"Kimi-K2\",\n  COALESCE((applied_weights->>'deepseek-v4-pro:cloud')::numeric, 0) AS \"DeepSeek-V4\"\nFROM weight_update_log\nWHERE (applied_at)\nORDER BY applied_at",
          "refId": "A",
          "sql": {}
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Signal Confidence by Model",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "alembic-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 1,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "unit": "none",
          "min": 0,
          "max": 1,
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "orientation": "vertical",
        "showValue": "always",
        "stacking": "none",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": -20
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "alembic-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  model_id AS \"Model\",\n  ROUND(AVG(confidence)::numeric, 4) AS \"Avg Confidence\",\n  COUNT(*) AS \"Signal Count\"\nFROM sentiment_signals\nWHERE $__timeFilter(generated_at)\nGROUP BY model_id\nORDER BY model_id",
          "refId": "A",
          "sql": {}
        }
      ]
    },
