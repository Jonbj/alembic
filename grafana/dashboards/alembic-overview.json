{
  "id": null,
  "uid": "alembic-overview",
  "title": "Alembic - Overview",
  "description": "Sentiment signals, model performance, LLM budget and news volume",
  "tags": ["alembic"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sentiment Scores Over Time",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "axisCenteredZero": true,
            "axisLabel": "Score",
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": -0.5 },
              { "color": "yellow", "value": -0.2 },
              { "color": "green", "value": 0.2 }
            ]
          },
          "min": -1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('hour', generated_at) AS time,\n  symbol AS metric,\n  ROUND(AVG(score)::numeric, 4) AS value\nFROM sentiment_signals\nWHERE $__timeFilter(generated_at)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "sql": {}
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Signal Score Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.85,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelRotation": -15
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE\n    WHEN score < -0.6 THEN '< -0.6 (Very Bearish)'\n    WHEN score < -0.2 THEN '-0.6 to -0.2 (Bearish)'\n    WHEN score < 0.2  THEN '-0.2 to 0.2 (Neutral)'\n    WHEN score < 0.6  THEN '0.2 to 0.6 (Bullish)'\n    ELSE '> 0.6 (Very Bullish)'\n  END AS bucket,\n  COUNT(*) AS count\nFROM sentiment_signals\nWHERE $__timeFilter(generated_at)\nGROUP BY 1\nORDER BY MIN(score)",
          "refId": "A",
          "sql": {}
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model Performance (IC / ICIR)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 4,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "green", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wrapText": false
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(AVG(composite_ic), 0) AS \"Avg IC (30d)\",\n  COALESCE(AVG(icir), 0) AS \"Avg ICIR (30d)\"\nFROM performance_metrics\nWHERE metric_date >= CURRENT_DATE - 30",
          "refId": "A",
          "sql": {}
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent Signals (last 50)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false,
            "minWidth": 80
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Score" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": -1 },
                    { "color": "yellow", "value": -0.2 },
                    { "color": "green", "value": 0.2 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  generated_at AS \"Time\",\n  symbol       AS \"Symbol\",\n  ROUND(score::numeric, 4)      AS \"Score\",\n  ROUND(confidence::numeric, 4) AS \"Confidence\",\n  model_id     AS \"Model\",\n  fallback_used AS \"Fallback\"\nFROM sentiment_signals\nORDER BY generated_at DESC\nLIMIT 50",
          "refId": "A",
          "sql": {}
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM Daily Spend (USD)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date::timestamptz AS time,\n  total_spent_usd AS \"Daily Spend\"\nFROM llm_budget\nWHERE date >= CURRENT_DATE - 30\nORDER BY date",
          "refId": "A",
          "sql": {}
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "News Volume (articles/hour)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "alembic-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('hour', fetched_at) AS time,\n  COUNT(*) AS \"Articles\"\nFROM news_log\nWHERE $__timeFilter(fetched_at)\nGROUP BY 1\nORDER BY 1",
          "refId": "A",
          "sql": {}
        }
      ]
    }
  ]
}
