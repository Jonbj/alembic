# .env.example — copy to .env and fill in real values. NEVER commit .env.
# Generate ADMIN_PASSWORD_HASH:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
ADMIN_API_KEY=change-me-in-production-min-32-chars

# Auth (JWT login)
ADMIN_USERNAME=admin
# Keep bcrypt hashes single-quoted: Docker Compose otherwise treats $... segments as variables.
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=change-me-in-production-min-32-chars-random
JWT_EXPIRE_MINUTES=1440

MARKETAUX_API_KEY=

# LLM (Claude CLI — must be authenticated via `claude auth`)
CLAUDE_CLI_PATH=claude
LLM_DAILY_BUDGET_USD=50.00
LLM_TIMEOUT_SECONDS=120

# Ollama cloud API
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Connectors
NEWSAPI_KEY=
FRED_API_KEY=
DEEPL_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# QuantConnect (cloud backtester — https://www.quantconnect.com/account)
QUANTCONNECT_USER_ID=
QUANTCONNECT_API_TOKEN=

# Alpaca Markets (paper/live trading — https://app.alpaca.markets/paper-trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
