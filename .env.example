# .env.example — copy to .env and fill in real values. NEVER commit .env.
# Generate ADMIN_PASSWORD_HASH:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
MOBILE_LOGIN_RATE_LIMIT=5
MOBILE_LOGIN_RATE_WINDOW_SECONDS=300
ADMIN_API_KEY=change-me-in-production-min-32-chars

# Auth (JWT login)
ADMIN_USERNAME=admin
# Keep bcrypt hashes single-quoted: Docker Compose otherwise treats $... segments as variables.
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=change-me-in-production-min-32-chars-random
JWT_EXPIRE_MINUTES=1440
# Comma-separated browser origins. Empty keeps the API same-origin only.
CORS_ALLOWED_ORIGINS=
API_LOGIN_RATE_LIMIT=5
API_LOGIN_RATE_WINDOW_SECONDS=300
API_ADMIN_ACTION_RATE_LIMIT=5
API_ADMIN_ACTION_RATE_WINDOW_SECONDS=60
MOBILE_ACCESS_TOKEN_EXPIRE_MINUTES=15
MOBILE_REFRESH_TOKEN_EXPIRE_DAYS=30
MOBILE_TOKEN_PEPPER=
# Mobile push (service-account file is mounted at runtime; never commit it)
FIREBASE_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=
FCM_USE_APPLICATION_DEFAULT_CREDENTIALS=false
FCM_FAKE_DELIVERY_ENABLED=false

MARKETAUX_API_KEY=

# LLM (Claude CLI — must be authenticated via `claude auth`)
CLAUDE_CLI_PATH=claude
LLM_DAILY_BUDGET_USD=50.00
LLM_TIMEOUT_SECONDS=120

# Ollama cloud API
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Connectors
NEWSAPI_KEY=
FRED_API_KEY=
DEEPL_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# QuantConnect (cloud backtester — https://www.quantconnect.com/account)
QUANTCONNECT_USER_ID=
QUANTCONNECT_API_TOKEN=

# Alpaca Markets (paper/live trading — https://app.alpaca.markets/paper-trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
